{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mlmsale",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_SITE_URL": "https://mlmsale.ir"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MARKET",
        "class_name": "Marketplace"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Marketplace"
      ]
    }
  ],
  "env": {
    "preview": {
      "name": "mlmsale-preview",
      "vars": {
        "PUBLIC_SITE_URL": ""
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "MARKET",
            "class_name": "Marketplace"
          }
        ]
      }
    }
  }
}